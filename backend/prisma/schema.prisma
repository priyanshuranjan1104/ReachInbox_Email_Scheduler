// ──────────────────────────────────────────────────────────────────────────────
// Prisma Schema — ReachInbox Email Scheduler
// ──────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────────────────────

enum JobStatus {
  PENDING    // Created, not yet started
  RUNNING    // Worker has begun processing emails
  COMPLETED  // All emails sent (or max attempts exhausted)
  CANCELLED  // User cancelled the job
  FAILED     // Unrecoverable failure
}

enum EmailStatus {
  SCHEDULED    // Created, waiting to be enqueued
  QUEUED       // Enqueued in BullMQ
  SENDING      // Worker is processing (in-flight)
  SENT         // Successfully delivered via SMTP
  FAILED       // Delivery failed (max retries exhausted)
  RATE_LIMITED // Paused due to rate limit
  RESCHEDULED  // Re-enqueued for a later window after rate limit
  CANCELLED    // Job was cancelled before this email was sent
}

enum RateLimitType {
  HOURLY_GLOBAL  // Global emails/hour limit
  PER_SENDER     // Per sender-email limit
}

// ──────────────────────────────────────────────────────────────────────────────
// User — authenticated via Google OAuth
// ──────────────────────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatar    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs              EmailJob[]
  slackInstallation SlackInstallation?

  @@map("users")
}

// ──────────────────────────────────────────────────────────────────────────────
// EmailJob — represents one bulk email scheduling request
// One job can contain 1..N individual emails
// ──────────────────────────────────────────────────────────────────────────────
model EmailJob {
  id     String @id @default(cuid())
  userId String

  // Email content (shared across all recipients in the batch)
  subject     String
  body        String    @db.Text
  senderEmail String    // The "From" address
  senderName  String?   // The "From" display name

  // Scheduling config (set at job creation, immutable)
  scheduledAt          DateTime // When to start sending the first email
  delayBetweenEmailsMs Int      @default(2000)  // Minimum ms between sends
  hourlyLimit          Int      @default(100)   // Max emails this job sends per hour
  totalRecipients      Int

  // Progress counters (updated by the worker)
  sentCount        Int @default(0)
  failedCount      Int @default(0)
  rescheduledCount Int @default(0)

  status      JobStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  // Rate-limit events generated by this job's processing
  rateLimitEvents RateLimitEvent[]

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
  @@map("email_jobs")
}

// ──────────────────────────────────────────────────────────────────────────────
// Email — one individual send within a job
// ──────────────────────────────────────────────────────────────────────────────
model Email {
  id    String @id @default(cuid())
  jobId String

  recipient String

  // Subject/body are copied from the job at creation
  // (allows future per-recipient personalisation)
  subject String
  body    String @db.Text

  status EmailStatus @default(SCHEDULED)

  // Idempotency key: SHA-256(jobId + recipient)
  // Prevents duplicate sends if the worker restarts mid-job
  idempotencyKey String  @unique

  // BullMQ job reference (nullable — set when the job is enqueued)
  bullmqJobId String?

  // Ethereal preview URL (set after successful send)
  etherealPreviewUrl String?

  // Scheduling timestamps
  scheduledAt DateTime
  sentAt      DateTime?
  failedAt    DateTime?

  // Error info for failed sends
  failureReason String?
  attemptCount  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job EmailJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
  @@index([recipient])
  @@index([scheduledAt])
  @@map("emails")
}

// ──────────────────────────────────────────────────────────────────────────────
// RateLimitEvent — audit log for every rate-limit hit
// Used to power Slack notifications and dashboard reporting
// ──────────────────────────────────────────────────────────────────────────────
model RateLimitEvent {
  id    String @id @default(cuid())
  jobId String

  // Which email was affected (null if a batch was paused)
  emailId String?

  limitType   RateLimitType
  senderEmail String

  // When was this email rescheduled to?
  rescheduledTo DateTime

  // Was the Slack notification sent for this event?
  slackNotified   Boolean   @default(false)
  slackNotifiedAt DateTime?

  createdAt DateTime @default(now())

  job EmailJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([createdAt])
  @@map("rate_limit_events")
}

// ──────────────────────────────────────────────────────────────────────────────
// SlackInstallation — stores the OAuth tokens for installed Slack workspaces
// Required for sending notifications via the Slack Web API
// ──────────────────────────────────────────────────────────────────────────────
model SlackInstallation {
  id     String @id @default(cuid())
  userId String @unique // One installation per user

  teamId   String
  teamName String

  // Bot token — xoxb-... Store as-is; encrypt at rest in production via KMS
  botToken  String
  botUserId String
  appId     String

  // The channel to post rate-limit notifications to
  // (set by user after OAuth, defaults to general)
  notificationChannelId String @default("#general")

  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("slack_installations")
}
