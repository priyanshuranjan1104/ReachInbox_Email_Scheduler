# ──────────────────────────────────────────────────────────────────────────────
# ReachInbox Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# ── Session ───────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
SESSION_MAX_AGE_MS=86400000

# ── PostgreSQL (Docker) ───────────────────────────────────────────────────────
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=changeme
POSTGRES_DB=reachinbox_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Prisma uses this full URL
DATABASE_URL=postgresql://reachinbox:changeme@localhost:5432/reachinbox_db?schema=public

# ── Redis (Docker) ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme
# Full URL form (used by some libraries)
REDIS_URL=redis://:changeme@localhost:6379

# ── Elasticsearch (Docker) ────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_EMAILS=emails

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at: https://console.developers.google.com/
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ── Slack OAuth ───────────────────────────────────────────────────────────────
# Create a Slack app at: https://api.slack.com/apps
# Required scopes: chat:write, chat:write.public
SLACK_CLIENT_ID=REPLACE_WITH_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=REPLACE_WITH_SLACK_CLIENT_SECRET
SLACK_SIGNING_SECRET=REPLACE_WITH_SLACK_SIGNING_SECRET
SLACK_REDIRECT_URI=http://localhost:3001/api/auth/slack/callback
# State secret for OAuth CSRF protection
SLACK_STATE_SECRET=REPLACE_WITH_SLACK_STATE_SECRET

# ── BullMQ Worker ─────────────────────────────────────────────────────────────
# How many email jobs to process in parallel (per worker instance)
WORKER_CONCURRENCY=5
# Minimum milliseconds between emails in the same job
DEFAULT_DELAY_BETWEEN_EMAILS_MS=2000
# Default max emails sent per hour (global)
DEFAULT_HOURLY_LIMIT=100

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
